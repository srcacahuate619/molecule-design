# MolDesign Backend — Environment Variables
# Copy to .env and fill in values

# === Required ===
SECRET_KEY=your_secret_key_at_least_32_characters_long
DATABASE_URL=postgresql+asyncpg://admin:Johan619.@192.168.1.64:5432/moldesign_db
REDIS_URL=redis://192.168.1.64:6379/0
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Johan619.
MINIO_ENDPOINT=192.168.1.64:9005

# === Deployment & Automation ===
# Token de acceso de Vercel para sincronización automática del túnel
VERCEL_TOKEN=vcp_your_vercel_token

# === IA & Reporting ===
# Google Gemini API Key para reportes científicos
GEMINI_API_KEY=AIzaSy...

# === Solana Blockchain (for certification) ===
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_solana_private_key_hex
VINA_EXECUTABLE_PATH=tools/vina/vina.exe

# === Optional ===
ENVIRONMENT=development
# ANTHROPIC_API_KEY=sk-ant-...   # For AI report generation (optional, degrades gracefully)
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
