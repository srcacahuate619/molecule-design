# MolDesign Backend — Environment Variables
# Copy to .env and fill in values

# === Required ===
SECRET_KEY=your_secret_key_at_least_32_characters_long
DATABASE_URL=postgresql+asyncpg://moldesign:moldesign@localhost:5432/moldesign_db
REDIS_URL=redis://localhost:6379/0
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_ENDPOINT=localhost:9000
VINA_EXECUTABLE_PATH=tools/vina/vina.exe

# === Optional ===
ENVIRONMENT=development
# ANTHROPIC_API_KEY=sk-ant-...   # For AI report generation (optional, degrades gracefully)
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
