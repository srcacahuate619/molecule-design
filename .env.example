# MolDesign — Global Environment Variables
# Copy to .env and fill in values for production deployment

# === Security ===
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Database & Cache ===
# Railway provides these automatically if you connect PostgreSQL and Redis services
DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db
REDIS_URL=redis://host:port/0

# === Storage (S3 / MinIO) ===
# For production, use AWS S3 or Cloudflare R2
STORAGE_BUCKET_NAME=moldesign-data
STORAGE_ENDPOINT=s3.amazonaws.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=us-east-1

# === AI Interpretation ===
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# === Solana Blockchain ===
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_private_key_in_hex

# === App Config ===
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["https://your-frontend.vercel.app"]
