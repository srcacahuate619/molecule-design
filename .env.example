# ============================================================================
# MolDesign — Variables de Entorno
# ============================================================================

# ── Aplicación ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Clave para firmar JWT. Genera con: openssl rand -hex 32
SECRET_KEY=cambia-esto-genera-con-openssl-rand-hex-32-minimo

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:Johan619.@192.168.1.64:5432/moldesign_db

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://192.168.1.64:6379/0

# ── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ENDPOINT=192.168.1.64:9005
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Johan619.
MINIO_SECURE=false

# ── AutoDock Vina ───────────────────────────────────────────────────────────
# Ruta al ejecutable de Vina. "vina" si está en PATH.
VINA_EXECUTABLE_PATH=vina

# ── IA (opcional) ───────────────────────────────────────────────────────────
# Sin esta clave, el reporte de IA se degrada gracefully (no bloquea nada).
ANTHROPIC_API_KEY= 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

